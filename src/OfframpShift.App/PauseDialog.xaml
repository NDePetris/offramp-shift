<Window x:Class="OfframpShift.App.PauseDialog"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Pause monitoring" Width="440" Height="500" MinWidth="400" MinHeight="400"
 FontFamily="Segoe UI" FontSize="14" WindowStartupLocation="CenterScreen"
 Background="{DynamicResource ShiftCanvas}" Foreground="{DynamicResource ShiftText}">
 <DockPanel Margin="24">
  <StackPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
   <TextBlock x:Name="Validation" AutomationProperties.LiveSetting="Polite" TextWrapping="Wrap"/>
   <WrapPanel HorizontalAlignment="Right">
    <Button Content="_Cancel" IsCancel="True"/>
    <Button Content="_Pause" IsDefault="True" Click="Confirm"/>
   </WrapPanel>
  </StackPanel>
  <ScrollViewer x:Name="PauseScroll" Style="{StaticResource ContentScroll}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <StackPanel>
    <TextBlock Text="Pause monitoring" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,8"/>
    <TextBlock Text="Usage, qualifying breaks and reminders stop during Pause." Margin="0,0,0,16"/>
    <Label Content="Pause _until" Target="{Binding ElementName=Choice}"/>
    <ComboBox x:Name="Choice" AutomationProperties.Name="Pause duration" SelectionChanged="SelectionChanged" MinHeight="36"/>
    <StackPanel x:Name="Custom" Visibility="Collapsed" Margin="0,12,0,0">
     <TextBlock x:Name="Zone" Margin="0,0,0,8"/>
     <Label Content="_Date" Target="{Binding ElementName=Date}"/>
     <DatePicker x:Name="Date" AutomationProperties.Name="Resume date" SelectedDateChanged="DateChanged"/>
     <Label Content="Local _time" Target="{Binding ElementName=Time}"/>
     <TextBox x:Name="Time" AutomationProperties.Name="Resume local clock time" TextChanged="TimeChanged"/>
     <StackPanel x:Name="Ambiguity" Visibility="Collapsed">
      <Label Content="Clock time occurs twice — choose an _occurrence" Target="{Binding ElementName=Occurrence}"/>
      <ComboBox x:Name="Occurrence" AutomationProperties.Name="First or second occurrence" MinHeight="36"/>
     </StackPanel>
    </StackPanel>
   </StackPanel>
  </ScrollViewer>
 </DockPanel>
</Window>
