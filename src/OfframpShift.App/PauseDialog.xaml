<Window x:Class="OfframpShift.App.PauseDialog"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Pause monitoring" Width="440" SizeToContent="Height" MinWidth="400" MinHeight="300"
 FontFamily="Segoe UI" FontSize="14" WindowStartupLocation="CenterScreen"
 Background="{DynamicResource ShiftCanvas}" Foreground="{DynamicResource ShiftText}">
 <Window.Resources>
  <Style x:Key="QuickDuration" TargetType="RadioButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
   <Setter Property="MinHeight" Value="36"/>
   <Setter Property="Padding" Value="8,6"/>
   <Setter Property="Margin" Value="0,0,8,0"/>
   <Setter Property="HorizontalContentAlignment" Value="Center"/>
  </Style>
 </Window.Resources>
 <DockPanel Margin="24">
  <StackPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
   <TextBlock x:Name="Validation" AutomationProperties.LiveSetting="Polite" TextWrapping="Wrap">
    <TextBlock.Style>
     <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
      <Setter Property="Margin" Value="0,0,0,8"/>
      <Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers>
     </Style>
    </TextBlock.Style>
   </TextBlock>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
    <Button x:Name="CancelButton" Content="_Cancel" IsCancel="True"/>
    <Button x:Name="PauseButton" Content="_Pause" IsDefault="True" Click="Confirm" Margin="0,4,0,4"/>
   </StackPanel>
  </StackPanel>
  <ScrollViewer x:Name="PauseScroll" Style="{StaticResource ContentScroll}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <StackPanel>
    <TextBlock Text="Pause monitoring" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,8"/>
    <TextBlock Text="Usage, qualifying breaks and reminders stop during Pause." Margin="0,0,0,16"/>
    <UniformGrid x:Name="QuickDurations" Rows="1" Margin="0,0,0,16">
     <RadioButton x:Name="FifteenMinutes" Content="_15 min" AutomationProperties.Name="Pause for 15 minutes" GroupName="PauseMode" Tag="0" Style="{StaticResource QuickDuration}" Checked="ChoiceChanged"/>
     <RadioButton x:Name="ThirtyMinutes" Content="_30 min" AutomationProperties.Name="Pause for 30 minutes" GroupName="PauseMode" Tag="1" Style="{StaticResource QuickDuration}" Checked="ChoiceChanged"/>
     <RadioButton x:Name="OneHour" Content="1 h_our" AutomationProperties.Name="Pause for 1 hour" GroupName="PauseMode" Tag="2" Style="{StaticResource QuickDuration}" Checked="ChoiceChanged"/>
     <RadioButton x:Name="TwoHours" Content="_2 hours" AutomationProperties.Name="Pause for 2 hours" GroupName="PauseMode" Tag="3" Style="{StaticResource QuickDuration}" Checked="ChoiceChanged" Margin="0"/>
    </UniformGrid>
    <RadioButton x:Name="CustomChoice" Content="_Until a specific date and time" GroupName="PauseMode" Tag="4" Checked="ChoiceChanged" MinHeight="32"/>
    <StackPanel x:Name="Custom" Visibility="Collapsed" Margin="24,8,0,12">
     <TextBlock x:Name="Zone" Foreground="{DynamicResource ShiftSupporting}" Margin="0,0,0,8"/>
     <Label Content="_Date" Target="{Binding ElementName=Date}"/>
     <DatePicker x:Name="Date" AutomationProperties.Name="Resume date" SelectedDateChanged="DateChanged"/>
     <Grid Margin="0,4,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Label Content="_Hour" Target="{Binding ElementName=Hour}"/>
      <Label Grid.Column="1" Content="_Minute" Target="{Binding ElementName=Minute}"/>
      <Label Grid.Column="2" Content="_AM/PM" Target="{Binding ElementName=Period}"/>
      <ComboBox x:Name="Hour" Grid.Row="1" AutomationProperties.Name="Resume hour" MinHeight="36" Margin="0,0,8,0" SelectionChanged="TimeChanged"/>
      <ComboBox x:Name="Minute" Grid.Row="1" Grid.Column="1" AutomationProperties.Name="Resume minute" MinHeight="36" Margin="0,0,8,0" SelectionChanged="TimeChanged"/>
      <ComboBox x:Name="Period" Grid.Row="1" Grid.Column="2" AutomationProperties.Name="Resume AM or PM" MinHeight="36" SelectionChanged="TimeChanged"/>
     </Grid>
     <StackPanel x:Name="Ambiguity" Visibility="Collapsed" Margin="0,8,0,0">
      <Label Content="Clock time occurs twice — choose an _occurrence" Target="{Binding ElementName=Occurrence}"/>
      <ComboBox x:Name="Occurrence" AutomationProperties.Name="First or second occurrence" MinHeight="36"/>
     </StackPanel>
    </StackPanel>
    <RadioButton x:Name="ManualChoice" Content="Until I _resume" GroupName="PauseMode" Tag="5" Checked="ChoiceChanged" MinHeight="32"/>
   </StackPanel>
  </ScrollViewer>
 </DockPanel>
</Window>
