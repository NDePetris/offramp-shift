<Application x:Class="OfframpShift.App.ShiftApplication"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 ShutdownMode="OnExplicitShutdown" ThemeMode="System">
 <Application.Resources>
  <ResourceDictionary>
   <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="/PresentationFramework.Fluent;component/Themes/Fluent.xaml" />
   </ResourceDictionary.MergedDictionaries>
   <SolidColorBrush x:Key="DeepMoss" Color="#2E5A4F" />
   <SolidColorBrush x:Key="WarmPaper" Color="#F6F3EC" />
   <SolidColorBrush x:Key="SoftSky" Color="#79AFC9" />
   <Style TargetType="TextBlock">
    <Setter Property="TextWrapping" Value="Wrap" />
   </Style>
   <Style TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
    <Setter Property="Margin" Value="0,4,8,4" />
    <Setter Property="Padding" Value="14,8" />
    <Setter Property="MinHeight" Value="36" />
   </Style>
   <Style TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxStyle}">
    <Setter Property="MinWidth" Value="140" />
    <Setter Property="Margin" Value="0,0,0,12" />
    <Setter Property="Padding" Value="8" />
   </Style>
   <Style x:Key="SectionTitle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="20" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Margin" Value="0,24,0,12" />
   </Style>
  </ResourceDictionary>
 </Application.Resources>
</Application>
