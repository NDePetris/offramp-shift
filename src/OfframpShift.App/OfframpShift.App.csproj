<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseAppHost>true</UseAppHost>
    <AssemblyTitle>Offramp Shift</AssemblyTitle>
    <Product>Offramp Shift</Product>
    <Description>Intentional transitions between personal and work contexts.</Description>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <PlatformTarget>x64</PlatformTarget>
    <StartupObject>OfframpShift.App.Program</StartupObject>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/Offramp/offramp-family-light.ico</ApplicationIcon>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <IncludeSourceRevisionInInformationalVersion>true</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets/Offramp/*.ico" />
    <Resource Include="Assets/Offramp/*.png" />
    <ProjectReference Include="../OfframpShift.ApplicationHost/OfframpShift.ApplicationHost.csproj" />
    <InternalsVisibleTo Include="OfframpShift.App.Tests" />
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>
</Project>
