<?xml version="1.0" ?>
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:OfframpShift.App" x:Class="OfframpShift.App.MainWindow" Title="Offramp Shift" Width="440" Height="540" MinWidth="400" MinHeight="500" FontFamily="Segoe UI" FontSize="14" WindowStartupLocation="CenterScreen" Background="{DynamicResource ShiftCanvas}" Foreground="{DynamicResource ShiftText}">
 <Window.Resources>
  <Style x:Key="RecordedText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
   <Setter Property="Foreground" Value="{DynamicResource ShiftSupporting}"/>
   <Style.Triggers>
    <Trigger Property="Text" Value="">
     <Setter Property="Visibility" Value="Collapsed"/>
    </Trigger>
   </Style.Triggers>
  </Style>
  <Style x:Key="ThinProgress" TargetType="ProgressBar">
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="ProgressBar">
      <Grid x:Name="PART_Track" Background="{TemplateBinding Background}" ClipToBounds="True">
       <Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}"/>
      </Grid>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
 </Window.Resources>
 <Grid Margin="20">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="*"/>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>
  <Grid x:Name="HomeHeader" Margin="0,0,0,12">
   <Grid.ColumnDefinitions>
    <ColumnDefinition Width="Auto"/>
    <ColumnDefinition Width="*"/>
    <ColumnDefinition Width="Auto"/>
   </Grid.ColumnDefinitions>
   <local:ContextIcon x:Name="ContextIcon" Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" FontSize="18" VerticalAlignment="Center" Margin="0,0,10,0" Focusable="False" IsHitTestVisible="False"/>
   <TextBlock Grid.Column="1" Text="{Binding ContextLabel}" VerticalAlignment="Center"/>
   <Button Grid.Column="2" x:Name="SettingsButton" Click="OpenSettings" Width="36" Padding="0" Margin="0" ToolTip="Settings" AutomationProperties.Name="Settings">
    <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="18" TextWrapping="NoWrap"/>
   </Button>
  </Grid>
  <Button x:Name="BackButton" Content="← Back" Click="GoBack" HorizontalAlignment="Left" Visibility="Collapsed" Margin="0,0,0,16" AutomationProperties.Name="Back to Home"/>
  <ScrollViewer x:Name="HomePage" Style="{StaticResource ContentScroll}" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <StackPanel MaxWidth="520" HorizontalAlignment="Stretch">
    <Border x:Name="TimerHero" Background="{DynamicResource ShiftHomeHero}" CornerRadius="20" Margin="0,0,0,12">
     <Grid>
      <local:QuietRoad x:Name="HeroRoad" HomeBackground="True"/>
      <StackPanel x:Name="HeroContent" Margin="16,12">
       <TextBlock Background="{DynamicResource ShiftHomeHero}" HorizontalAlignment="Left" Text="{Binding HeroLabel}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,4"/>
       <TextBlock x:Name="HeroTimer" Text="{Binding HeroValue}" FontSize="60" MinHeight="84" FontWeight="SemiBold" Foreground="{DynamicResource ShiftAccent}" Background="{DynamicResource ShiftHomeHero}" HorizontalAlignment="Left" Typography.NumeralAlignment="Tabular"/>
       <TextBlock Background="{DynamicResource ShiftHomeHero}" HorizontalAlignment="Left" Text="{Binding RecordedQualifier}" Style="{StaticResource RecordedText}"/>
       <TextBlock Background="{DynamicResource ShiftHomeHero}" HorizontalAlignment="Left" Text="{Binding Arithmetic}" Foreground="{DynamicResource ShiftSupporting}" Margin="0,4,0,8"/>
       <TextBlock Background="{DynamicResource ShiftHomeHero}" HorizontalAlignment="Left" Text="The allowance remains exhausted until a qualifying break or explicit Reset usage." Visibility="{Binding ShowExhaustionExplanation, Converter={StaticResource BooleanToVisibility}}" Margin="0,0,0,12"/>
       <ProgressBar Style="{StaticResource ThinProgress}" Visibility="{Binding ShowUsageProgress, Converter={StaticResource BooleanToVisibility}}" Value="{Binding UsageProgress, Mode=OneWay}" Maximum="100" Height="4" Foreground="{DynamicResource ShiftAccent}" Background="{DynamicResource ShiftTrack}" AutomationProperties.Name="Recorded allowance usage" AutomationProperties.HelpText="{Binding Arithmetic}" Margin="0,0,0,8"/>
       <StackPanel Visibility="{Binding ShowReminder, Converter={StaticResource BooleanToVisibility}}" Margin="0,0,0,8">
        <WrapPanel>
         <TextBlock Background="{DynamicResource ShiftHomeHero}" HorizontalAlignment="Left" Text="{Binding ReminderLabel}" VerticalAlignment="Center"/>
         <TextBlock Background="{DynamicResource ShiftHomeHero}" HorizontalAlignment="Left" Text="{Binding ReminderValue}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource ShiftAccent}" Margin="12,0,0,0"/>
        </WrapPanel>
        <TextBlock Background="{DynamicResource ShiftHomeHero}" HorizontalAlignment="Left" Text="{Binding RecordedQualifier}" Style="{StaticResource RecordedText}"/>
        <TextBlock Background="{DynamicResource ShiftHomeHero}" HorizontalAlignment="Left" Text="Advances only during eligible Personal time" FontSize="12" Foreground="{DynamicResource ShiftSupporting}" Margin="0,4,0,0"/>
       </StackPanel>
      </StackPanel>
     </Grid>
    </Border>

    <DockPanel Margin="0,0,0,8">
     <TextBlock DockPanel.Dock="Right" Text="{Binding BreakValue}" Foreground="{DynamicResource ShiftSupporting}" Margin="12,0,0,0"/>
     <TextBlock Text="Qualifying break" FontWeight="SemiBold"/>
    </DockPanel>
    <TextBlock Text="{Binding RecordedQualifier}" Style="{StaticResource RecordedText}" FontSize="12"/>
    <ProgressBar Style="{StaticResource ThinProgress}" Value="{Binding BreakProgress, Mode=OneWay}" Maximum="100" Height="4" Foreground="{DynamicResource ShiftAccent}" Background="{DynamicResource ShiftTrack}" AutomationProperties.Name="Recorded qualifying break" AutomationProperties.HelpText="{Binding BreakValue}"/>
    <TextBlock Text="{Binding BreakExplanation}" Foreground="{DynamicResource ShiftSupporting}" FontSize="12" Margin="0,8,0,16"/>
    <TextBlock x:Name="PauseStatusText" Text="{Binding PauseStatus}" Style="{StaticResource RecordedText}" AutomationProperties.LiveSetting="Polite"/>
    <WrapPanel Margin="0,0,0,16">
     <Button x:Name="MonitoringButton" Content="{Binding MonitoringActionLabel}" Click="ToggleMonitoring" IsEnabled="{Binding CanToggleMonitoring}" Visibility="{Binding ShowMonitoringAction, Converter={StaticResource BooleanToVisibility}}"/>
     <Button Content="Change pause…" Click="ChangePause" IsEnabled="{Binding CanChangePause}" Visibility="{Binding ShowChangePause, Converter={StaticResource BooleanToVisibility}}"/>
    </WrapPanel>
    <TextBlock Text="{Binding Health}" Foreground="{DynamicResource ShiftSupporting}" FontSize="12"/>
    <StackPanel Visibility="{Binding ShowHealthDetail, Converter={StaticResource BooleanToVisibility}}" Margin="0,8,0,0">
     <TextBlock Text="{Binding Detail}" FontSize="12"/>
     <Button x:Name="SetupButton" Content="Review desktop set_up" Click="OpenSetup" HorizontalAlignment="Left"/>
     <Button Content="Start monitoring" Click="Start" HorizontalAlignment="Left" Visibility="{Binding CanStart, Converter={StaticResource BooleanToVisibility}}"/>
     <WrapPanel>
      <Button Content="{Binding RetryLabel}" Click="RetryMonitoring" Visibility="{Binding CanRetryMonitoring, Converter={StaticResource BooleanToVisibility}}"/>
      <Button Content="Retry save" Click="RetrySave" Visibility="{Binding CanRetrySave, Converter={StaticResource BooleanToVisibility}}"/>
      <Button Content="Reopen storage" Click="ReopenStorage" Visibility="{Binding CanReopen, Converter={StaticResource BooleanToVisibility}}"/>
      <Button Content="Recover accounting…" Click="Recover" Visibility="{Binding CanRecover, Converter={StaticResource BooleanToVisibility}}"/>
     </WrapPanel>
    </StackPanel>
    <TextBlock x:Name="ActionResult" Style="{StaticResource RecordedText}" AutomationProperties.LiveSetting="Polite" Margin="0,8,0,0"/>
   </StackPanel>
  </ScrollViewer>
  <ScrollViewer x:Name="SettingsOverview" Style="{StaticResource ContentScroll}" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <StackPanel>
    <TextBlock Text="Settings" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,16"/>
    <Button Click="OpenDetail" Tag="Desktop" HorizontalContentAlignment="Stretch" HorizontalAlignment="Stretch" MinHeight="56" Margin="0,0,0,8">
     <StackPanel>
      <TextBlock Text="Desktop setup" FontWeight="SemiBold"/>
      <TextBlock Text="Personal and Work assignments" FontSize="12"/>
     </StackPanel>
    </Button>
    <Button Click="OpenDetail" Tag="Monitoring" HorizontalContentAlignment="Stretch" HorizontalAlignment="Stretch" MinHeight="56" Margin="0,0,0,8">
     <StackPanel>
      <TextBlock Text="Monitoring" FontWeight="SemiBold"/>
      <TextBlock Text="Allowance and qualifying break" FontSize="12"/>
     </StackPanel>
    </Button>
    <Button Click="OpenDetail" Tag="Reminders" HorizontalContentAlignment="Stretch" HorizontalAlignment="Stretch" MinHeight="56" Margin="0,0,0,8">
     <StackPanel>
      <TextBlock Text="Reminders" FontWeight="SemiBold"/>
      <TextBlock Text="Reminder style and repeat interval" FontSize="12"/>
     </StackPanel>
    </Button>
    <Button Click="OpenDetail" Tag="Appearance" HorizontalContentAlignment="Stretch" HorizontalAlignment="Stretch" MinHeight="56" Margin="0,0,0,8">
     <StackPanel>
      <TextBlock Text="Appearance and closing" FontWeight="SemiBold"/>
      <TextBlock Text="Theme and tray behavior" FontSize="12"/>
     </StackPanel>
    </Button>
    <Button Click="OpenDetail" Tag="Advanced" HorizontalContentAlignment="Stretch" HorizontalAlignment="Stretch" MinHeight="56" Margin="0,0,0,8">
     <StackPanel>
      <TextBlock Text="Advanced" FontWeight="SemiBold"/>
      <TextBlock Text="Recovery and experimental switching" FontSize="12"/>
     </StackPanel>
    </Button>
   </StackPanel>
  </ScrollViewer>
  <ScrollViewer x:Name="SettingsDetail" Style="{StaticResource ContentScroll}" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <StackPanel>
    <TextBlock x:Name="SettingsResult" Style="{StaticResource RecordedText}" AutomationProperties.LiveSetting="Polite" Margin="0,0,0,8"/>
    <StackPanel x:Name="SettingsControls" IsEnabled="{Binding CommandsIdle}">
     <StackPanel.Resources>
      <Style x:Key="SectionTitle" TargetType="TextBlock">
       <Setter Property="TextWrapping" Value="Wrap"/>
       <Setter Property="FontSize" Value="20"/>
       <Setter Property="FontWeight" Value="SemiBold"/>
       <Setter Property="Margin" Value="0,0,0,16"/>
      </Style>
      <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
       <Setter Property="ContentTemplate">
        <Setter.Value>
         <DataTemplate>
          <AccessText Text="{Binding}" TextWrapping="Wrap"/>
         </DataTemplate>
        </Setter.Value>
       </Setter>
      </Style>
     </StackPanel.Resources>
     <StackPanel x:Name="DesktopSection" Visibility="Collapsed">
      <TextBlock x:Name="SetupHeading" Text="Desktop setup" Style="{StaticResource SectionTitle}"/>
      <TextBlock Text="{Binding NextSetupAction}" Margin="0,0,0,12"/>
      <TextBlock Text="Allow read-only desktop observation on supported Windows. Start monitoring separately to begin accounting." Visibility="{Binding CanConsent, Converter={StaticResource BooleanToVisibility}}" Margin="0,0,0,8"/>
      <Button x:Name="ConsentButton" Content="I _agree — enable experimental observation" Click="Consent" HorizontalAlignment="Left" IsEnabled="{Binding CanConsent}" Visibility="{Binding CanConsent, Converter={StaticResource BooleanToVisibility}}"/>
      <TextBlock Text="{Binding PersonalStatus}" Margin="0,16,0,4"/>
      <TextBlock Text="{Binding WorkStatus}" Margin="0,0,0,8"/>
      <TextBlock Text="{Binding Context}"/>
      <WrapPanel Margin="0,8,0,0">
       <Button x:Name="PersonalButton" Content="Use current desktop as _Personal" Click="AssignPersonal" IsEnabled="{Binding CanAssign}"/>
       <Button x:Name="WorkButton" Content="Use current desktop as _Work" Click="AssignWork" IsEnabled="{Binding CanAssign}"/>
      </WrapPanel>
      <TextBlock Text="{Binding StartStatus}" Margin="0,12,0,4"/>
      <Button x:Name="SetupStartButton" Content="_Start monitoring" Click="Start" IsEnabled="{Binding CanStart}" HorizontalAlignment="Left"/>
      <Expander Header="How desktop setup works" Margin="0,16,0,0">
       <StackPanel>
        <TextBlock Text="{Binding ConsentStatus}" Margin="0,0,0,8"/>
        <TextBlock Text="Choose each desktop in Task View, then assign Personal or Work using the tray menu without opening this window. Assignments must be distinct, valid desktop GUIDs. Reassignment stops monitoring until you Start again."/>
        <TextBlock Text="Assignment never switches desktops automatically. Observation requires explicit consent and an approved Windows build. Monitoring uses bounded estimates; Explorer recovery and sustained reliability remain unresolved." Margin="0,8,0,0"/>
       </StackPanel>
      </Expander>
     </StackPanel>
     <StackPanel x:Name="MonitoringSection" Visibility="Collapsed">
      <TextBlock Text="Monitoring" Style="{StaticResource SectionTitle}"/>
      <Label Content="_Personal allowance (minutes)" Target="{Binding ElementName=AllowanceInput}"/>
      <TextBox x:Name="AllowanceInput" HorizontalAlignment="Left" AutomationProperties.Name="Personal allowance in minutes"/>
      <Label Content="Required _qualifying break (minutes)" Target="{Binding ElementName=BreakInput}"/>
      <TextBox x:Name="BreakInput" HorizontalAlignment="Left" AutomationProperties.Name="Required qualifying break in minutes"/>
      <TextBlock Text="Changes apply to future accounting. Saving clears an unfinished qualifying break." Foreground="{DynamicResource ShiftSupporting}" Margin="0,4,0,12"/>
      <TextBlock Text="A longer allowance does not clear exhaustion. Take a qualifying break or use Reset usage…" Foreground="{DynamicResource ShiftSupporting}" FontSize="12" Margin="0,0,0,12"/>
      <Expander Header="More monitoring options" Margin="0,4,0,12">
       <StackPanel>
        <Label Content="Reminder _inactivity threshold (seconds)" Target="{Binding ElementName=IdleInput}"/>
        <TextBox x:Name="IdleInput" HorizontalAlignment="Left" AutomationProperties.Name="Reminder inactivity threshold in seconds"/>
        <TextBlock Text="Inactivity suppresses reminders. Eligible Personal time still counts; only Work or lock qualifies as a break." FontSize="12"/>
        <Button x:Name="ResetUsageButton" Content="Reset _usage…" Click="ResetUsage" IsEnabled="{Binding CanResetUsage}" HorizontalAlignment="Left" AutomationProperties.HelpText="Requires confirmation. Clears usage and break progress; preserves settings and Pause."/>
       </StackPanel>
      </Expander>
     </StackPanel>
     <StackPanel x:Name="RemindersSection" Visibility="Collapsed">
      <TextBlock Text="Reminders" Style="{StaticResource SectionTitle}"/>
      <Label Content="_Reminder style" Target="{Binding ElementName=RemindersInput}"/>
      <ComboBox x:Name="RemindersInput" IsEnabled="{Binding CanEditReminders}" HorizontalAlignment="Left" MinWidth="220" AutomationProperties.Name="Reminder style"/>
      <TextBlock Text="Off by default. Reminds you when your Personal allowance runs out." Foreground="{DynamicResource ShiftSupporting}" Margin="0,8,0,8"/>
      <Button x:Name="SaveRemindersButton" Content="Save reminder style" Click="SaveReminders" IsEnabled="{Binding CanEditReminders}" HorizontalAlignment="Left"/>
      <Border Height="1" Background="{DynamicResource ShiftDivider}" Margin="0,12,0,12"/>
      <Label Content="Repeat interval (_minutes, 1–60)" Target="{Binding ElementName=RepeatInput}"/>
      <TextBox x:Name="RepeatInput" HorizontalAlignment="Left" AutomationProperties.Name="Reminder repeat interval in whole minutes" IsEnabled="{Binding CanEdit}"/>
      <Button x:Name="SaveRepeatButton" Content="Save repeat interval" Click="SaveRepeat" IsEnabled="{Binding CanEdit}" HorizontalAlignment="Left"/>
      <TextBlock Text="Style and repeat interval save separately." FontSize="12" Foreground="{DynamicResource ShiftSupporting}" Margin="0,8,0,8"/>
      <Expander Header="About reminders" Margin="0,8,0,8">
       <TextBlock Text="Windows notifications may be suppressed or delayed. The interactive window can take foreground focus. Changing style preserves usage and break progress. Repeats and extra time advance only during counted Personal use, including unlocked Personal time without input. Work and lock do not count."/>
      </Expander>
      <Button Content="Cancel" Click="CancelDraft" HorizontalAlignment="Left"/>
     </StackPanel>
     <StackPanel x:Name="AppearanceSection" Visibility="Collapsed">
      <TextBlock Text="Appearance and closing" Style="{StaticResource SectionTitle}"/>
      <Label Content="_Theme" Target="{Binding ElementName=ThemeInput}"/>
      <ComboBox x:Name="ThemeInput" HorizontalAlignment="Left" MinWidth="160" AutomationProperties.Name="Theme"/>
      <CheckBox x:Name="CloseInput" AutomationProperties.Name="Keep running in the tray when I close the window" Margin="0,16,0,8">
       <TextBlock Text="Keep running in the tray when I close the window"/>
      </CheckBox>
      <TextBlock Text="Tray Exit always stops the app. Pause is saved across restart; a timed Pause ends at its saved deadline." Foreground="{DynamicResource ShiftSupporting}" Margin="0,0,0,16"/>
      <WrapPanel>
       <Button Content="Save changes" Click="SaveAppearance" IsEnabled="{Binding CanEditReminders}"/>
       <Button Content="Cancel" Click="CancelDraft"/>
      </WrapPanel>
      <Button Content="E_xit Offramp Shift" Click="Exit" HorizontalAlignment="Left" Margin="0,20,0,0"/>
     </StackPanel>
     <StackPanel x:Name="AdvancedSection" Visibility="Collapsed">
      <TextBlock Text="Advanced" Style="{StaticResource SectionTitle}"/>
      <TextBlock Text="Diagnostics" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
      <CheckBox x:Name="DiagnosticsInput" Content="Show Diagnostics" Click="ChangeDiagnostics" AutomationProperties.Name="Show Diagnostics"/>
      <TextBlock Text="Inspect monitoring, accounting and recovery in a separate window." Foreground="{DynamicResource ShiftSupporting}" Margin="0,8,0,12"/>
      <Button x:Name="OpenDiagnosticsButton" Content="Open Diagnostics" Click="OpenDiagnostics" IsEnabled="False" HorizontalAlignment="Left"/>
      <TextBlock x:Name="DiagnosticsPreferenceResult" AutomationProperties.LiveSetting="Polite" FontSize="12"/>
      <Border Height="1" Background="{DynamicResource ShiftDivider}" Margin="0,16,0,12"/>
      <Expander Header="Recovery and maintenance" Margin="0,0,0,16">
       <StackPanel>
        <TextBlock Text="{Binding Persistence}"/>
        <TextBlock Text="{Binding Detail}" Margin="0,8,0,8"/>
        <WrapPanel>
         <Button Content="{Binding RetryLabel}" Click="RetryMonitoring" IsEnabled="{Binding CanRetryMonitoring}"/>
         <Button Content="Retry save" Click="RetrySave" IsEnabled="{Binding CanRetrySave}"/>
         <Button Content="Reopen storage" Click="ReopenStorage" IsEnabled="{Binding CanReopen}"/>
         <Button Content="Recover accounting…" Click="Recover" IsEnabled="{Binding CanRecover}"/>
        </WrapPanel>
        <Button Content="Repair Windows settings…" Click="RepairSettings" IsEnabled="{Binding CanRepairSettings}" HorizontalAlignment="Left"/>
       </StackPanel>
      </Expander>
      <Expander Header="Experimental switching" Margin="0,0,0,16">
       <StackPanel>
        <CheckBox x:Name="SwitchingInput" IsEnabled="{Binding CanEditReminders}" AutomationProperties.Name="Allow an explicit Switch to Work attempt from a nudge">
         <TextBlock Text="Allow an explicit Switch to Work attempt from a nudge"/>
        </CheckBox>
        <TextBlock Text="Separate consent · Supported Windows only. Default off. No automatic switching or retries. An uncertain result may include a delayed transition; check Win+Tab." Margin="0,8,0,8"/>
        <TextBlock x:Name="SwitchingCapability" FontSize="12" Margin="0,0,0,8"/>
        <WrapPanel>
         <Button Content="Save switching consent" Click="SaveSwitching" IsEnabled="{Binding CanEditReminders}"/>
         <Button Content="Cancel" Click="CancelDraft"/>
        </WrapPanel>
       </StackPanel>
      </Expander>
      <Expander Header="Technical monitoring details">
       <StackPanel>
        <TextBlock Text="{Binding Status}"/>
        <TextBlock Text="{Binding Confidence}"/>
        <TextBlock x:Name="NudgeStatus"/>
       </StackPanel>
      </Expander>
      <TextBlock Text="Diagnostics is off by default." FontSize="12" Foreground="{DynamicResource ShiftSupporting}" Margin="0,16,0,0"/>
     </StackPanel>
    </StackPanel>
   </StackPanel>
  </ScrollViewer>
  <StackPanel x:Name="MonitoringActions" Grid.Row="2" Visibility="Collapsed" IsEnabled="{Binding CommandsIdle}">
   <Border Height="1" Background="{DynamicResource ShiftDivider}" Margin="0,12,0,8"/>
   <WrapPanel>
    <Button Content="Save changes" Click="SaveDurations" IsEnabled="{Binding CanEdit}"/>
    <Button x:Name="MonitoringCancelButton" Content="Cancel" Click="CancelDraft"/>
   </WrapPanel>
  </StackPanel>
  <TextBlock Grid.Row="3" Text="Estimated accounting · Local only · Owner evaluation" FontSize="12" Foreground="{DynamicResource ShiftSupporting}" Margin="0,12,0,0"/>
 </Grid>
</Window>
