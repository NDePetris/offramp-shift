<Window x:Class="OfframpShift.App.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:OfframpShift.App"
 Title="Offramp Shift" Width="820" Height="760" MinWidth="480" MinHeight="420"
 FontFamily="Segoe UI" FontSize="14" WindowStartupLocation="CenterScreen"
 Background="{DynamicResource WindowBackground}" Foreground="{DynamicResource WindowForeground}">
 <DockPanel Margin="24">
  <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
   <local:FamilySymbolImage x:Name="FamilySymbol" Width="48" Height="48" Stretch="Uniform" Margin="0,0,14,0" DockPanel.Dock="Left" Focusable="False" />
   <StackPanel>
    <TextBlock Text="Offramp Shift" FontSize="26" FontWeight="SemiBold" />
    <TextBlock Text="A little space between personal time and work." Margin="0,4,0,0" />
   </StackPanel>
  </DockPanel>
  <TextBlock DockPanel.Dock="Bottom" Margin="0,14,0,0" Text="Owner evaluation • Estimated accounting • Local only. Automatic switching and website attribution are unavailable." />
  <TabControl x:Name="Navigation" AutomationProperties.Name="Main navigation">
   <TabItem Header="_Home">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
     <StackPanel>
      <TextBlock Text="{Binding Status}" FontSize="24" FontWeight="SemiBold" AutomationProperties.LiveSetting="Polite" />
      <TextBlock Text="{Binding Detail}" Margin="0,8,0,16" />
      <StackPanel Visibility="{Binding NeedsSetup, Converter={StaticResource BooleanToVisibility}}">
       <TextBlock Text="Monitoring setup" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12" />
       <TextBlock Text="{Binding ConsentStatus}" />
       <TextBlock Text="{Binding PersonalStatus}" Margin="0,4,0,0" />
       <TextBlock Text="{Binding WorkStatus}" Margin="0,4,0,0" />
       <TextBlock Text="{Binding StartStatus}" Margin="0,4,0,0" />
       <TextBlock Text="{Binding NextSetupAction}" Margin="0,8,0,4" />
      </StackPanel>
      <WrapPanel Margin="0,8,0,12">
       <Button x:Name="SetupButton" Content="Review desktop set_up" Click="OpenSetup" />
       <Button Content="_Start monitoring" Click="Start" IsEnabled="{Binding CanStart}" />
       <Button Content="_Pause" Click="Pause" IsEnabled="{Binding CanPause}" />
       <Button Content="_Resume" Click="Resume" IsEnabled="{Binding CanResume}" />
      </WrapPanel>
      <TextBlock x:Name="ActionResult" AutomationProperties.LiveSetting="Polite" Margin="0,0,0,12" />
      <TextBlock Text="Current desktop context" FontWeight="SemiBold" />
      <TextBlock Text="{Binding Context}" Margin="0,4,0,0" FontSize="18" />
      <TextBlock Text="Usage and allowance" Style="{StaticResource SectionTitle}" />
      <TextBlock Text="{Binding Usage}" />
      <TextBlock Text="{Binding Advisory}" Margin="0,4,0,0" />
      <ProgressBar Value="{Binding UsageProgress, Mode=OneWay}" Maximum="100" Height="12" Margin="0,10,0,8" AutomationProperties.Name="Saved allowance usage" AutomationProperties.HelpText="{Binding Usage}" />
      <TextBlock Text="{Binding Confidence}" />
      <TextBlock Text="Break progress" Style="{StaticResource SectionTitle}" />
      <TextBlock Text="{Binding Break}" />
      <ProgressBar Value="{Binding BreakProgress, Mode=OneWay}" Maximum="100" Height="12" Margin="0,10,0,8" AutomationProperties.Name="Saved qualifying break progress" AutomationProperties.HelpText="{Binding Break}" />
      <TextBlock Text="Storage and recovery" Style="{StaticResource SectionTitle}" />
      <TextBlock Text="{Binding Persistence}" />
      <WrapPanel>
       <Button Content="{Binding RetryLabel}" Click="RetryMonitoring" IsEnabled="{Binding CanRetryMonitoring}" />
       <Button Content="Retry save" Click="RetrySave" IsEnabled="{Binding CanRetrySave}" />
       <Button Content="Reopen storage" Click="ReopenStorage" IsEnabled="{Binding CanReopen}" />
       <Button Content="Recover accounting…" Click="Recover" IsEnabled="{Binding CanRecover}" />
      </WrapPanel>
     </StackPanel>
    </ScrollViewer>
   </TabItem>
   <TabItem Header="Se_ttings">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
     <StackPanel>
      <TextBlock x:Name="SetupHeading" Text="Desktop setup" Style="{StaticResource SectionTitle}" />
      <TextBlock Text="Monitoring uses bounded estimates and can miss activity. Explorer recovery and sustained reliability remain unresolved. Consent enables read-only desktop observation on the allowlisted Windows build; Start monitoring enables accounting." />
      <TextBlock Text="{Binding NextSetupAction}" Margin="0,12,0,12" />
      <TextBlock Text="{Binding ConsentStatus}" />
      <Button x:Name="ConsentButton" Content="I _agree — enable experimental observation" Click="Consent" HorizontalAlignment="Left" IsEnabled="{Binding CanConsent}" />
      <TextBlock Text="{Binding Bindings}" Margin="0,12,0,12" />
      <TextBlock Text="Current desktop context" FontWeight="SemiBold" />
      <TextBlock Text="{Binding Context}" Margin="0,4,0,12" />
      <TextBlock Text="Manually choose each desktop in Task View. Use the Offramp Shift tray menu on that desktop to assign Personal or Work without opening this window. Existing assignments are replaced only by your explicit action. Reassignment stops monitoring until you Start again." />
      <WrapPanel Margin="0,8,0,0">
       <Button x:Name="PersonalButton" Content="Use current desktop as _Personal" Click="AssignPersonal" IsEnabled="{Binding CanAssign}" />
       <Button x:Name="WorkButton" Content="Use current desktop as _Work" Click="AssignWork" IsEnabled="{Binding CanAssign}" />
      </WrapPanel>
      <TextBlock Text="{Binding StartStatus}" Margin="0,12,0,4" />
      <Button x:Name="SetupStartButton" Content="_Start monitoring" Click="Start" IsEnabled="{Binding CanStart}" HorizontalAlignment="Left" />
      <TextBlock x:Name="SettingsResult" AutomationProperties.LiveSetting="Polite" Margin="0,12,0,0" />
      <TextBlock Text="Monitoring" Style="{StaticResource SectionTitle}" />
      <TextBlock Text="Duration changes apply prospectively and clear an unfinished break. Increasing allowance does not clear an exhausted allowance; take a qualifying break or explicitly reset usage." Margin="0,0,0,12" />
      <Label Content="_Allowance (minutes)" Target="{Binding ElementName=AllowanceInput}" />
      <TextBox x:Name="AllowanceInput" HorizontalAlignment="Left" AutomationProperties.Name="Allowance in minutes" />
      <Label Content="Required _break (minutes)" Target="{Binding ElementName=BreakInput}" />
      <TextBox x:Name="BreakInput" HorizontalAlignment="Left" AutomationProperties.Name="Required break in minutes" />
      <Label Content="_Idle threshold (seconds)" Target="{Binding ElementName=IdleInput}" />
      <TextBox x:Name="IdleInput" HorizontalAlignment="Left" AutomationProperties.Name="Idle threshold in seconds" />
      <Button Content="Save monitoring settings" Click="SaveDurations" IsEnabled="{Binding CanEdit}" HorizontalAlignment="Left" />
      <Button x:Name="ResetUsageButton" Content="Reset _usage…" Click="ResetUsage" IsEnabled="{Binding CanResetUsage}" HorizontalAlignment="Left" AutomationProperties.HelpText="Requires confirmation. Clears accumulated usage and break progress; preserves settings and Pause." />
      <TextBlock Text="Break reminders" Style="{StaticResource SectionTitle}" />
      <Label Content="_Reminder style" Target="{Binding ElementName=RemindersInput}" />
      <ComboBox x:Name="RemindersInput" IsEnabled="{Binding CanEditReminders}" HorizontalAlignment="Left" MinWidth="220" AutomationProperties.Name="Reminder style" />
      <TextBlock Text="Off by default. Windows notification keeps the existing grace period and repeat timing; Windows may suppress or delay it. Interactive window prompts immediately when your allowance runs out and can take foreground focus. Changing style preserves usage and break progress." Margin="0,8,0,8" />
      <Button x:Name="SaveRemindersButton" Content="Save reminder preference" Click="SaveReminders" IsEnabled="{Binding CanEditReminders}" HorizontalAlignment="Left" />
      <Label Content="Interactive window repeat interval (_minutes, 1–60)" Target="{Binding ElementName=RepeatInput}" />
      <TextBox x:Name="RepeatInput" HorizontalAlignment="Left" AutomationProperties.Name="Interactive repeat interval in whole minutes" IsEnabled="{Binding CanEdit}" />
      <TextBlock Text="Repeats and extra time advance only during counted Personal use. Time on Work or away from the computer doesn't count." Margin="0,0,0,8" />
      <Button x:Name="SaveRepeatButton" Content="Save interactive repeat interval" Click="SaveRepeat" IsEnabled="{Binding CanEdit}" HorizontalAlignment="Left" />
      <TextBlock Text="Appearance and closing" Style="{StaticResource SectionTitle}" />
      <Label Content="_Theme" Target="{Binding ElementName=ThemeInput}" />
      <ComboBox x:Name="ThemeInput" HorizontalAlignment="Left" MinWidth="160" AutomationProperties.Name="Theme" />
      <CheckBox x:Name="CloseInput" Content="Keep running in the tray when I close the window" Margin="0,16,0,8" />
      <TextBlock Text="Tray Exit stops the app. Previously enabled monitoring resumes on later app launches when setup and providers are valid. Pause is preserved across restart. Windows login startup is not configured." />
      <Button Content="Save appearance and close behavior" Click="SaveAppearance" HorizontalAlignment="Left" />
      <Button Content="Repair Windows settings…" Click="RepairSettings" IsEnabled="{Binding CanRepairSettings}" HorizontalAlignment="Left" />
      <Button Content="E_xit Offramp Shift" Click="Exit" HorizontalAlignment="Left" />
     </StackPanel>
    </ScrollViewer>
   </TabItem>
  </TabControl>
 </DockPanel>
</Window>
