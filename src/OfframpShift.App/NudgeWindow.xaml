<Window x:Class="OfframpShift.App.NudgeWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:OfframpShift.App"
 Title="Offramp Shift — time for a break" Width="400" MinWidth="320" SizeToContent="Height"
 ResizeMode="NoResize" ShowActivated="False" WindowStartupLocation="Manual"
 FontFamily="Segoe UI" FontSize="14"
 Background="{DynamicResource ShiftCanvas}" Foreground="{DynamicResource ShiftText}">
 <ScrollViewer Style="{StaticResource ContentScroll}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <StackPanel Margin="20">
   <Border Background="{DynamicResource ShiftHero}" CornerRadius="16" Padding="12" Margin="0,0,0,12">
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <local:FamilySymbolImage x:Name="FamilySymbol" Width="24" Height="24" Margin="0,0,12,0" Focusable="False" />
     <TextBlock x:Name="NudgeHeading" Grid.Column="1" Text="Time for a break" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center" Focusable="True" KeyboardNavigation.IsTabStop="False" />
     <local:QuietRoad x:Name="ReminderRoad" Grid.Column="2" Width="48" Height="60" Margin="8,0,0,0"/>
    </Grid>
   </Border>
   <TextBlock Text="You've used your Personal time for now." Margin="0,0,0,12" />
   <Button x:Name="SwitchWork" Content="Switch to _Work" Click="SwitchToWork" IsEnabled="False" FontWeight="SemiBold" HorizontalAlignment="Left"
           IsDefault="False" Foreground="{DynamicResource ShiftAccent}" AutomationProperties.Name="Switch to Work" />
   <TextBlock x:Name="SwitchWarning" Foreground="{DynamicResource ShiftSupporting}" AutomationProperties.LiveSetting="Polite" Margin="0,4,0,8" />
   <WrapPanel>
    <Button x:Name="OneMinute" Content="Add _1 minute" Click="AddOne" AutomationProperties.Name="Add 1 minute" />
    <Button x:Name="FiveMinutes" Content="Add _5 minutes" Click="AddFive" AutomationProperties.Name="Add 5 minutes" />
   </WrapPanel>
   <TextBlock Text="Extra time counts only during eligible Personal use." Foreground="{DynamicResource ShiftSupporting}" Margin="0,8,0,8" />
   <Expander Header="How this works" Margin="0,0,0,8">
    <StackPanel Margin="0,8,0,0">
     <TextBlock x:Name="SwitchAvailability" Text="Checking switching availability. Press Win+Tab and select Work manually." Margin="0,0,0,8" />
     <TextBlock Text="Time on Work or while locked doesn't count. Unlocked Personal time counts even without input." Margin="0,0,0,8" />
     <TextBlock Text="Closing this window reminds you again after 1 minute of Personal use. Opening Offramp Shift leaves this reminder open." />
    </StackPanel>
   </Expander>
   <Button x:Name="OpenMainButton" Content="Open Offramp Shift" Click="OpenMain" HorizontalAlignment="Left" Foreground="{DynamicResource ShiftAccent}" AutomationProperties.Name="Open Offramp Shift" />
   <TextBlock x:Name="Result" AutomationProperties.LiveSetting="Polite" Margin="0,12,0,0" />
  </StackPanel>
 </ScrollViewer>
</Window>
