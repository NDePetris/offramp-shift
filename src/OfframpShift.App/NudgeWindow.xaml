<Window x:Class="OfframpShift.App.NudgeWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:OfframpShift.App"
 Title="Offramp Shift — time for a break" Width="400" MinWidth="320" Height="300"
 ResizeMode="NoResize" ShowInTaskbar="True" ShowActivated="False" WindowStartupLocation="Manual"
 FontFamily="Segoe UI" FontSize="14"
 Background="{DynamicResource ShiftCanvas}" Foreground="{DynamicResource ShiftText}">
 <Window.Resources>
  <DataTemplate x:Key="TimeActionContent">
   <AccessText Text="{Binding}" TextWrapping="Wrap" TextAlignment="Center"/>
  </DataTemplate>
  <Style x:Key="NavigationAction" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Background" Value="Transparent"/>
   <Setter Property="BorderThickness" Value="0"/>
   <Setter Property="Foreground" Value="{DynamicResource ShiftAccent}"/>
   <Setter Property="Padding" Value="4,6"/>
   <Setter Property="Margin" Value="0"/>
  </Style>
  <Style x:Key="Feedback" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
   <Setter Property="Margin" Value="0,8,0,0"/>
   <Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers>
  </Style>
 </Window.Resources>
 <Grid Margin="20,16">
  <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <ScrollViewer x:Name="ActionScroll" Style="{StaticResource ContentScroll}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <StackPanel x:Name="ActionView">
    <Grid Margin="8,4,0,16">
     <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <local:FamilySymbolImage x:Name="FamilySymbol" Width="36" Height="36" Margin="0,0,16,0" Focusable="False"/>
     <TextBlock x:Name="NudgeHeading" Grid.Column="1" Text="Time for a break" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center" Focusable="True" KeyboardNavigation.IsTabStop="False"/>
    </Grid>
    <Button x:Name="SwitchWork" Content="Switch to _Work" Click="SwitchToWork" IsEnabled="False" FontWeight="SemiBold" Margin="0,0,0,8" HorizontalAlignment="Stretch"
            IsDefault="False" Background="{DynamicResource ShiftAccent}" Foreground="{DynamicResource ShiftCanvas}" AutomationProperties.Name="Switch to Work"/>
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Button x:Name="OneMinute" Content="Add _1 minute" ContentTemplate="{StaticResource TimeActionContent}" Click="AddOne" Margin="0,0,6,0" HorizontalAlignment="Stretch" AutomationProperties.Name="Add 1 minute"/>
     <Button x:Name="FiveMinutes" Grid.Column="1" Content="Add _5 minutes" ContentTemplate="{StaticResource TimeActionContent}" Click="AddFive" Margin="6,0,0,0" HorizontalAlignment="Stretch" AutomationProperties.Name="Add 5 minutes"/>
    </Grid>
    <TextBlock x:Name="SwitchWarning" Style="{StaticResource Feedback}" Foreground="{DynamicResource ShiftSupporting}" AutomationProperties.LiveSetting="Polite"/>
    <TextBlock x:Name="Result" Style="{StaticResource Feedback}" AutomationProperties.LiveSetting="Polite"/>
   </StackPanel>
  </ScrollViewer>
  <Grid x:Name="HelpView" Visibility="Collapsed" AutomationProperties.Name="How this works">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <Button x:Name="BackButton" Content="Back to reminder" Click="BackToReminder" Style="{StaticResource NavigationAction}" HorizontalAlignment="Left"/>
   <TextBlock Grid.Row="1" Text="How this works" FontSize="24" FontWeight="SemiBold" Margin="0,8,0,16"/>
   <ScrollViewer x:Name="HelpScroll" Grid.Row="2" Style="{StaticResource ContentScroll}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel>
     <TextBlock Text="Switching desktops" FontWeight="SemiBold" Margin="0,0,0,4"/>
     <TextBlock x:Name="SwitchAvailability" Margin="0,0,0,16"/>
     <TextBlock Text="Extra Personal time" FontWeight="SemiBold" Margin="0,0,0,4"/>
     <TextBlock Text="Extra time counts only during eligible unlocked Personal use, including when you're not typing. Time on Work or while locked doesn't count." Margin="0,0,0,16"/>
     <TextBlock Text="Closing this reminder" FontWeight="SemiBold" Margin="0,0,0,4"/>
     <TextBlock Text="Closing this window reminds you again after 1 minute of Personal use. Opening Offramp Shift leaves this reminder open."/>
    </StackPanel>
   </ScrollViewer>
  </Grid>
  <Border Grid.Row="1" BorderBrush="{DynamicResource ShiftDivider}" BorderThickness="0,1,0,0" Margin="0,12,0,0" Padding="0,8,0,0">
   <Grid x:Name="FooterNavigation">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Button x:Name="HelpButton" Click="ShowHelp" Style="{StaticResource NavigationAction}" HorizontalAlignment="Left" Margin="0,0,4,0" AutomationProperties.Name="How this works">
     <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <local:ContextIcon Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="14" TextWrapping="NoWrap" VerticalAlignment="Center" Margin="0,0,6,0" Focusable="False" IsHitTestVisible="False"/>
      <TextBlock Grid.Column="1" Text="How this works" VerticalAlignment="Center"/>
     </Grid>
    </Button>
    <Button x:Name="OpenMainButton" Grid.Column="1" Click="OpenMain" Style="{StaticResource NavigationAction}" HorizontalAlignment="Right" Margin="4,0,0,0" AutomationProperties.Name="Open Offramp Shift">
     <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock Text="Open Offramp Shift" VerticalAlignment="Center" TextAlignment="Right"/>
      <local:ContextIcon Grid.Column="1" Text="&#xE8A7;" FontFamily="Segoe MDL2 Assets" FontSize="14" TextWrapping="NoWrap" VerticalAlignment="Center" Margin="6,0,0,0" Focusable="False" IsHitTestVisible="False"/>
     </Grid>
    </Button>
   </Grid>
  </Border>
 </Grid>
</Window>
